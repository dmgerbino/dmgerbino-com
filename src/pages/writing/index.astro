---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('writing', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const iso = (d: Date) => d.toISOString().slice(0, 10);
---

<Base
  title="Writing — David Gerbino"
  description="Essays on fintech, banking data, regulatory analytics, and building with AI."
>
  <h1>Writing</h1>
  <ul class="entry-list">
    {posts.map((post) => (
      <li>
        <time datetime={iso(post.data.pubDate)}>{iso(post.data.pubDate)}</time>
        <a href={`/writing/${post.id}`}>{post.data.title}</a>
      </li>
    ))}
  </ul>
</Base>
