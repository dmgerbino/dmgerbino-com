---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** 'website' | 'article' */
  ogType?: string;
  /** Extra JSON-LD objects to inject alongside the sitewide graph */
  jsonLd?: object[];
  noindex?: boolean;
  /** Absolute-from-root path to a share image, e.g. a 1200x628 chart export */
  image?: string;
  /**
   * Widen the content band. Reports need it: an 880px chart cannot render
   * at 1:1 inside the 42rem reading measure, and scaling it down breaks
   * the chart text floor. Prose inside stays at the reading measure.
   */
  wide?: boolean;
}

const {
  title,
  description,
  ogType = 'website',
  jsonLd = [],
  noindex = false,
  image,
  wide = false,
} = Astro.props;
const imageUrl = image ? new URL(image, Astro.site).href : undefined;
const canonical = new URL(Astro.url.pathname, Astro.site).href.replace(/\/$/, '') || Astro.site;

const SITE_NAME = 'David Gerbino';

// Sitewide entity graph: who this site is and who is behind it.
const siteGraph = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': 'https://www.dmgerbino.com/#website',
    url: 'https://www.dmgerbino.com',
    name: SITE_NAME,
    description:
      'David Gerbino builds fintech data products with AI-assisted development and publishes recurring research on DMARC, GEO, and SEO across banks, credit unions, and neobanks.',
    publisher: { '@id': 'https://www.dmgerbino.com/#person' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    '@id': 'https://www.dmgerbino.com/#person',
    name: 'David Gerbino',
    url: 'https://www.dmgerbino.com',
    sameAs: ['https://x.com/dmgerbino'],
    knowsAbout: [
      'fintech',
      'banking data',
      'FFIEC call reports',
      'regulatory analytics',
      'data visualization',
      'AI-assisted software development',
      'DMARC email authentication',
      'generative engine optimization (GEO)',
      'search engine optimization (SEO)',
      'U.S. labor market data (BLS)',
    ],
  },
];

const allJsonLd = [...siteGraph, ...jsonLd];
const nav = [
  { href: '/projects', label: 'Projects' },
  { href: '/research', label: 'Research' },
  { href: '/now', label: 'Now' },
  { href: '/writing', label: 'Writing' },
  { href: '/about', label: 'About' },
];
const path = Astro.url.pathname.replace(/\/$/, '');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="alternate" type="application/rss+xml" title={SITE_NAME} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {imageUrl && <meta property="og:image" content={imageUrl} />}
    <meta name="twitter:card" content={imageUrl ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:site" content="@dmgerbino" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {imageUrl && <meta name="twitter:image" content={imageUrl} />}

    <script type="application/ld+json" set:html={JSON.stringify(allJsonLd)} />

    <script is:inline>
      // Theme: honor saved choice, else OS preference. Inline to avoid FOUC.
      (function () {
        var saved = localStorage.getItem('theme');
        var dark = saved
          ? saved === 'dark'
          : window.matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.setAttribute('data-theme', dark ? 'dark' : 'light');
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap">
        <a class="site-name" href="/">David Gerbino</a>
        <nav class="site-nav" aria-label="Site">
          {nav.map((item) => (
            <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          ))}
        </nav>
        <span class="theme-toggle-wrap">
          <label class="toggle" for="theme-toggle">
            <input type="checkbox" id="theme-toggle" role="switch" aria-label="Dark mode" aria-checked="false" />
            <span class="toggle-track"></span>
          </label>
        </span>
      </div>
    </header>
    <main id="main" class:list={['wrap', wide && 'wrap-wide']}>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <span>© {new Date().getFullYear()} David Gerbino</span>
        <a href="https://x.com/dmgerbino">X</a>
        <a href="/rss.xml">RSS</a>
        <a href="/llms.txt">llms.txt</a>
      </div>
    </footer>
    <script is:inline>
      (function () {
        var input = document.getElementById('theme-toggle');
        input.checked = document.documentElement.getAttribute('data-theme') === 'dark';
        input.setAttribute('aria-checked', String(input.checked));
        input.addEventListener('change', function () {
          var next = input.checked ? 'dark' : 'light';
          document.documentElement.setAttribute('data-theme', next);
          input.setAttribute('aria-checked', String(input.checked));
          localStorage.setItem('theme', next);
        });
      })();
    </script>
  </body>
</html>
